{
  "name": "@cold-crossing/wnight-cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "wNIGHT developer CLI: deploy, deposit, transfer, redeem on Preprod (online; keys on this machine)",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "proof:up": "docker compose -f ../../compose.yml up -d --wait proof-server",
    "proof:down": "docker compose -f ../../compose.yml stop proof-server",
    "wallets": "MIDNIGHT_NETWORK=preprod tsx src/wallets.ts",
    "deploy": "MIDNIGHT_NETWORK=preprod tsx src/deploy.ts",
    "deposit": "MIDNIGHT_NETWORK=preprod tsx src/deposit.ts",
    "consolidate": "MIDNIGHT_NETWORK=preprod tsx src/consolidate.ts",
    "transfer": "MIDNIGHT_NETWORK=preprod tsx src/transfer.ts",
    "wasm-transfer": "MIDNIGHT_NETWORK=preprod MIDNIGHT_PROVER=wasm tsx src/wasm-transfer.ts",
    "redeem": "MIDNIGHT_NETWORK=preprod tsx src/redeem.ts",
    "compile": "npm run -w @cold-crossing/contract compile",
    "compile:fast": "npm run -w @cold-crossing/contract compile:fast",
    "test": "npm run -w @cold-crossing/contract test"
  },
  "dependencies": {
    "@midnight-ntwrk/midnight-js-contracts": "5.0.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "5.0.1",
    "@midnight-ntwrk/midnight-js-protocol": "5.0.1",
    "@midnight-ntwrk/midnight-js-types": "5.0.1",
    "@midnight-ntwrk/midnight-js-utils": "5.0.1",
    "@midnight-ntwrk/testkit-js": "5.0.1",
    "@midnightntwrk/wallet-sdk": "2.0.1",
    "@midnightntwrk/wallet-sdk-prover-client": "2.0.1",
    "dotenv": "^16.4.5",
    "effect": "3.22.4",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "rxjs": "^7.8.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.9",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0"
  }
}
