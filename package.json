{
  "name": "midnight-cold-hot-transfer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc && node scripts/build-receiver.mjs && node scripts/build-cold-page.mjs && node scripts/build-hot-page.mjs",
    "test": "tsc --project tsconfig.test.json && node --test dist-test/tests/*.js",
    "test:page": "node scripts/test-cold-page.mjs",
    "test:server": "python3 -m unittest discover -s tests-hot",
    "test:hotpage": "node scripts/test-hot-page.mjs",
    "test:sdk": "tsc --project tsconfig.test.json && node --test --test-force-exit dist-test/tests-sdk/*.js",
    "keygen": "node dist/keygen.js",
    "cold:export-public": "node dist/cold-export-public.js",
    "hot:watch": "node dist/hot-watch.js",
    "hot:dust-watch": "node dist/dust-watch.js",
    "cold:transfer": "node dist/cold-transfer.js",
    "hot:sponsor-register": "node dist/sponsor-register.js",
    "hot:sponsor-submit": "node dist/sponsor-submit.js",
    "qr:send": "node dist/qr-send.js",
    "qr:decode": "node dist/qr-decode.js",
    "probe:cold-era": "node dist/probe-cold-era.js",
    "fetch:prover-keys": "node scripts/fetch-prover-keys.mjs",
    "build:prover-lab": "tsc && node scripts/build-prover-lab.mjs",
    "test:prover-lab": "node scripts/test-prover-lab.mjs",
    "prover-lab:node": "node scripts/prover-lab-node.mjs",
    "hot:zswap-feed": "node dist/hot-zswap-feed.js",
    "cold:shielded-transfer": "node dist/cold-shielded-transfer.js"
  },
  "dependencies": {
    "@midnightntwrk/wallet-sdk": "2.0.0",
    "@midnightntwrk/wallet-sdk-prover-client": "2.0.0",
    "@midnightntwrk/zkir-v2": "2.2.0",
    "@scure/bip39": "2.4.0",
    "qrcode-generator": "1.4.4",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@noble/hashes": "2.4.0",
    "@scure/base": "2.4.0",
    "@types/node": "24.10.1",
    "esbuild": "0.25.10",
    "fflate": "0.8.3",
    "jsqr": "1.4.0",
    "typescript": "5.9.3"
  }
}
