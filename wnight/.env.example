# Copy to .env (gitignored). Test-only wallets: NEVER use a wallet that holds
# Mainnet funds. The CLI refuses every network except preprod.

# --- Required -----------------------------------------------------------------

# Only 'preprod' is accepted (the npm scripts also set it).
MIDNIGHT_NETWORK=preprod

# Blockfrost serves the Preprod indexer and node RPC. Create a
# "Midnight Preprod" project at https://blockfrost.io and paste its project ID.
BLOCKFROST_PROJECT_ID=

# Wallet A (deposits, sends wNIGHT) and wallet B (receives, redeems).
# Set ONE of MNEMONIC_x or SEED_x per wallet.
#   MNEMONIC_x: 12-24 word recovery phrase (e.g. a Lace test wallet), in quotes.
#   SEED_x:     64 hex chars, no 0x. Fresh one: openssl rand -hex 32
MNEMONIC_A=
SEED_A=
MNEMONIC_B=
SEED_B=

# --- Optional -----------------------------------------------------------------

# Proof server. Default http://127.0.0.1:6300 (npm run proof:up).
# MIDNIGHT_PROOF_SERVER=http://127.0.0.1:6300

# How long a built transaction stays valid, seconds. Default 3600.
# MIDNIGHT_TX_TTL_SECONDS=3600

# How long to wait for faucet tNIGHT and DUST to accrue, ms. Default 1800000 (30 min).
# MIDNIGHT_FUND_TIMEOUT_MS=1800000

# DUST a wallet must hold before transacting. Default 60.
# MIDNIGHT_MIN_DUST=60

# Set to 'off' to disable the wallet sync cache in .wallet-state/.
# MIDNIGHT_WALLET_STATE=off

# pino log level. Default info.
# LOG_LEVEL=info          (warn = quietest; trace = every wallet sync update)

# While a wallet syncs, print a progress line at most this often, ms. Default 15000.
# MIDNIGHT_SYNC_LOG_INTERVAL_MS=15000

# While a wallet syncs, save its progress to .wallet-state/ this often, ms, so an
# interrupted run resumes instead of starting over. Also saved on Ctrl-C. Default 300000.
# MIDNIGHT_WALLET_SAVE_INTERVAL_MS=300000

# A fresh wallet's DUST sync starts at the ledger 9 fork, found once by a
# patient search and cached in .wallet-state/dust-fork-*.json (see
# cli/src/dustFork.ts). Set to 'off' to leave it to the SDK's own search,
# which usually times out on Blockfrost and replays all DUST history (~1 day).
# MIDNIGHT_DUST_FORK_SEARCH=on
# How long each indexer request in that search may take, ms. Default 120000.
# MIDNIGHT_DUST_FORK_PROBE_TIMEOUT_MS=120000
