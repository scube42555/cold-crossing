{
  // The tests import the built scripts by the package's own name ("cold-crossing/txinfo.js" is dist/txinfo.js, typed by
  // dist-types/), so they test what the cold bundle ships. npm test runs tsc -b first.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "dist-test"
  },
  "include": [
    "tests/**/*.ts",
    "tests-sdk/**/*.ts"
  ]
}
